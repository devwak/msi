<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingTop="24dp">

        <!-- Domain（必填） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Domain（必填）"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary" />

        <EditText
            android:id="@+id/etDomain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="例如 www.cloudflare.com / cloudflare.com"
            android:text="www.cloudflare.com"
            android:inputType="textUri"
            android:singleLine="true"
            android:textSize="16sp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:background="?android:attr/editTextBackground" />

        <!-- ECH -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <CheckBox
                android:id="@+id/cbEch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="启用 ECH"
                android:checked="true" />

            <TextView
                android:id="@+id/tvEchHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" (Go TLS，任意 Android 可用)"
                android:textSize="12sp"
                android:textColor="#888888" />
        </LinearLayout>

        <EditText
            android:id="@+id/etEchConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="cloudflare-ech.com+https://dns.alidns.com/dns-query"
            android:inputType="text"
            android:singleLine="true"
            android:minHeight="48dp"
            android:padding="12dp" />

        <!-- 协议 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="协议"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:textSize="15sp" />

        <RadioGroup
            android:id="@+id/rgProtocol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <RadioButton
                android:id="@+id/rbH3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="H3"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbH2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="H2"
                android:layout_marginStart="24dp" />
        </RadioGroup>

        <!-- 并发 / 超时 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="并发" />

            <EditText
                android:id="@+id/etConcurrency"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="20"
                android:inputType="number"
                android:gravity="center"
                android:minHeight="48dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="超时(ms)"
                android:layout_marginStart="20dp" />

            <EditText
                android:id="@+id/etTimeout"
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="5000"
                android:inputType="number"
                android:gravity="center"
                android:minHeight="48dp" />
        </LinearLayout>

        <!-- IP 池 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IP 池（一行一个，自动去重/去空行）"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etIpList"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="4dp"
            android:hint="粘贴 IP，或点「加载文件」"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:scrollbars="vertical"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnLoadFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="加载 IP 文件" />

        <!-- 操作按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="开始测试" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="停止"
                android:enabled="false" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="保存结果"
                android:enabled="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="就绪（需先构建 Go AAR）" />

        <!-- 结果列表 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="可用结果（按耗时升序，点击复制）"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:textSize="15sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvResults"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="4dp"
            android:background="#11000000" />

    </LinearLayout>
</ScrollView>
